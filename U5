screenGui.Parent = CoreGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 170, 0, 45)
mainFrame.Position = UDim2.new(0.5, -85, 0, 15)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
mainFrame.BackgroundTransparency = 0.2
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = mainFrame

local statsLabel = Instance.new("TextLabel")
statsLabel.Size = UDim2.new(1, 0, 0, 22)
statsLabel.Position = UDim2.new(0, 0, 0, 2)
statsLabel.BackgroundTransparency = 1
statsLabel.Font = Enum.Font.GothamBold
statsLabel.TextSize = 13
statsLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
statsLabel.TextXAlignment = Enum.TextXAlignment.Center
statsLabel.TextStrokeTransparency = 0.5
statsLabel.Parent = mainFrame

local colorsContainer = Instance.new("Frame")
colorsContainer.Size = UDim2.new(1, -20, 0, 14)
colorsContainer.Position = UDim2.new(0, 10, 0, 26)
colorsContainer.BackgroundTransparency = 1
colorsContainer.Parent = mainFrame

local paletteColors = {
    Color3.fromRGB(0, 255, 100),
    Color3.fromRGB(0, 150, 255),
    Color3.fromRGB(255, 50, 50),
    Color3.fromRGB(255, 255, 0),
    Color3.fromRGB(255, 0, 255),
    Color3.fromRGB(255, 255, 255)
}

local btnSize = 12
local totalSpacing = (#paletteColors - 1) * 4
local totalWidth = (#paletteColors * btnSize) + totalSpacing
local startX = (mainFrame.AbsoluteSize.X - totalWidth) / 2

for i, col in ipairs(paletteColors) do
    local colorBtn = Instance.new("TextButton")
    colorBtn.Size = UDim2.new(0, btnSize, 0, btnSize)
    colorBtn.Position = UDim2.new(0, (i - 1) * (btnSize + 4), 0, 0)
    colorBtn.BackgroundColor3 = col
    colorBtn.AutoButtonColor = false
    colorBtn.Text = ""
    colorBtn.Parent = colorsContainer

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(1, 0)
    btnCorner.Parent = colorBtn

    colorBtn.MouseButton1Click:Connect(function()
        statsLabel.TextColor3 = col
    end)
end

local fps, lastUpdate = 0, tick()
local frameCount = 0

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local currentTime = tick()
    
    if currentTime - lastUpdate >= 1 then
        fps = math.floor(frameCount / (currentTime - lastUpdate))
        frameCount = 0
        lastUpdate = currentTime
    end

    local ping = 0
    pcall(function()
        ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)

    statsLabel.Text = string.format("FPS: %d | MS: %d ms", fps, ping)
end)
